DATABASE_URL=postgres://postgres:password@localhost:5432/stock_analyst
BACKEND_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Financial Modeling Prep API (mock_fmp_key のままなら通信せずモック動作・課金なし)
FMP_API_KEY=mock_fmp_key

# LLM API (LLM_API_KEY=mock_llm_key のままなら外部APIへは一切通信せず完全無料・ローカル推論フォールバック動作)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=mock_llm_key
# 新規銘柄追加・四半期決算バッチのDCF成長率推論モデル (デフォルト: argon)
LLM_MODEL=argon
# 日次ニュース3行要約専用の軽量LLMモデル
LLM_NEWS_MODEL=gemini-3.5-flash-lite

# LINE Messaging API (mock_line_token のままなら通信せず画面＆ログ出力のみ)
LINE_CHANNEL_ACCESS_TOKEN=mock_line_token
LINE_USER_ID=mock_line_user_id
