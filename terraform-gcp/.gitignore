# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which contain sensitive data such as
# Supabase DATABASE_URL, API keys, and tokens.
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
