# ============================================================================
# Google Cloud + Supabase Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# ============================================================================

project_id = "your-gcp-project-id"
region     = "asia-northeast1"
artifact_registry_repo_id = "kinun-signal-images"

# Supabase PostgreSQL Session Mode Pooler URL (IPv4 compatible, Tokyo ap-northeast-1)
database_url = "postgresql://postgres.fercjbbethixmzwdhiyr:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Optional External API Keys (Leave as mock_* to use Graceful Fallback mode)
fmp_api_key               = "mock_fmp_key"
llm_api_base_url          = "https://api.openai.com/v1"
llm_api_key               = "mock_llm_key"
llm_model                 = "argon"
line_channel_access_token = "mock_line_token"
line_user_id              = "mock_line_user_id"

# Public HTTP Access for Frontend (Protected by Basic Auth; Backend is always IAM-restricted)
allow_public_access = true
basic_auth_user     = "admin"
basic_auth_password = "CHANGE_ME_STRONG_PASSWORD"

# Cloud Scheduler Cron Settings (JST / Asia/Tokyo)
daily_check_cron    = "30 6 * * 2-6"
earnings_check_cron = "35 6 * * 2-6"
scheduler_timezone  = "Asia/Tokyo"

# Cloud Monitoring Uptime Check & Alerting (Slack / Email)
uptime_check_path              = "/api/system/info" # or "/healthz" for Frontend-only shallow check
uptime_check_period            = "300s"             # 5-minute interval
alert_slack_channel_name       = ""                 # Pattern 1 (Bot Token): e.g. "#alerts"
alert_slack_bot_token          = ""                 # Pattern 1 (Bot Token): e.g. "xoxb-..."
alert_notification_channel_ids = []                 # Pattern 2 (GCP Console Slack OAuth): e.g. ["projects/YOUR_PROJECT/notificationChannels/12345"]
alert_notification_email       = ""                 # Optional Email fallback: e.g. "your-email@example.com"
